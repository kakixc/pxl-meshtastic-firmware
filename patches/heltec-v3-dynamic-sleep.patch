diff --git a/src/sleep.cpp b/src/sleep.cpp
index 64bd0c4..18995fd 100644
--- a/src/sleep.cpp
+++ b/src/sleep.cpp
@@ -370,6 +370,149 @@ void doDeepSleep(uint32_t msecToWake, bool skipPreflight = false, bool skipSaveN
 }
 
 #ifdef ARCH_ESP32
+#ifdef PXL_HELTEC_V3_DYNAMIC_SLEEP
+static esp_pm_lock_handle_t pxlLightSleepLock;
+static bool pxlLightSleepReady;
+static bool pxlLightSleepAllowed;
+
+static gpio_num_t pxlButtonPin()
+{
+    return (gpio_num_t)(config.device.button_gpio ? config.device.button_gpio : BUTTON_PIN);
+}
+
+static void clearPxlLightSleepWake()
+{
+    esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_EXT1);
+    esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_EXT0);
+    rtc_gpio_hold_dis(pxlButtonPin());
+    rtc_gpio_deinit(pxlButtonPin());
+#if defined(LORA_DIO1) && (LORA_DIO1 != RADIOLIB_NC)
+    rtc_gpio_hold_dis((gpio_num_t)LORA_DIO1);
+    rtc_gpio_deinit((gpio_num_t)LORA_DIO1);
+#endif
+}
+
+bool initPxlDynamicLightSleep()
+{
+#if defined(CONFIG_PM_ENABLE) && defined(CONFIG_FREERTOS_USE_TICKLESS_IDLE)
+    if (pxlLightSleepReady)
+        return true;
+
+    esp_err_t err = esp_pm_lock_create(ESP_PM_NO_LIGHT_SLEEP, 0, "pxl-v3", &pxlLightSleepLock);
+    if (err != ESP_OK) {
+        LOG_ERROR("PXL PM lock create failed: %d", err);
+        return false;
+    }
+    err = esp_pm_lock_acquire(pxlLightSleepLock);
+    if (err != ESP_OK) {
+        LOG_ERROR("PXL PM lock acquire failed: %d", err);
+        esp_pm_lock_delete(pxlLightSleepLock);
+        pxlLightSleepLock = nullptr;
+        return false;
+    }
+
+    esp_pm_config_esp32_t pmConfig = {};
+    // Match Meshtastic's later setCPUFast(false) call; change sleep policy,
+    // not the normal Heltec V3 CPU frequency.
+    pmConfig.max_freq_mhz = 80;
+    pmConfig.min_freq_mhz = 80;
+#if HAS_WIFI && !MESHTASTIC_EXCLUDE_WIFI
+    if (isWifiAvailable()) {
+        pmConfig.max_freq_mhz = 240;
+        pmConfig.min_freq_mhz = pmConfig.max_freq_mhz;
+    }
+#endif
+    pmConfig.light_sleep_enable = true;
+    err = esp_pm_configure(&pmConfig);
+    if (err != ESP_OK) {
+        LOG_ERROR("PXL PM configure failed: %d", err);
+        esp_pm_lock_release(pxlLightSleepLock);
+        esp_pm_lock_delete(pxlLightSleepLock);
+        pxlLightSleepLock = nullptr;
+        return false;
+    }
+
+    pxlLightSleepReady = true;
+    LOG_INFO("PXL PM configured: CPU %d-%d MHz, automatic light sleep permitted", pmConfig.min_freq_mhz, pmConfig.max_freq_mhz);
+    return true;
+#else
+    LOG_ERROR("PXL PM unavailable: framework lacks PM or tickless idle");
+    return false;
+#endif
+}
+
+bool pxlDynamicLightSleepAvailable()
+{
+    return pxlLightSleepReady;
+}
+
+bool setPxlDynamicLightSleep(bool allow)
+{
+    if (!pxlLightSleepReady)
+        return false;
+    if (allow == pxlLightSleepAllowed)
+        return true;
+
+    if (allow) {
+        if (!rtc_gpio_is_valid_gpio(pxlButtonPin())
+#if defined(LORA_DIO1) && (LORA_DIO1 != RADIOLIB_NC)
+            || !rtc_gpio_is_valid_gpio((gpio_num_t)LORA_DIO1)
+#endif
+        ) {
+            LOG_ERROR("PXL wake pins must support RTC wake");
+            return false;
+        }
+
+        notifyLightSleep.notifyObservers(nullptr); // Detach the regular USER ISR.
+        esp_err_t err = rtc_gpio_pullup_en(pxlButtonPin());
+        if (err == ESP_OK)
+            err = rtc_gpio_hold_en(pxlButtonPin());
+        if (err == ESP_OK)
+            err = esp_sleep_enable_ext1_wakeup(1ULL << pxlButtonPin(), ESP_EXT1_WAKEUP_ANY_LOW);
+        if (err != ESP_OK) {
+            LOG_ERROR("PXL USER RTC wake setup failed: %d", err);
+            clearPxlLightSleepWake();
+            notifyLightSleepEnd.notifyObservers(ESP_SLEEP_WAKEUP_UNDEFINED);
+            return false;
+        }
+#if defined(LORA_DIO1) && (LORA_DIO1 != RADIOLIB_NC)
+        err = rtc_gpio_pulldown_en((gpio_num_t)LORA_DIO1);
+        if (err == ESP_OK)
+            err = rtc_gpio_hold_en((gpio_num_t)LORA_DIO1);
+        if (err == ESP_OK)
+            err = esp_sleep_enable_ext0_wakeup((gpio_num_t)LORA_DIO1, HIGH);
+        if (err != ESP_OK) {
+            LOG_ERROR("PXL LoRa RTC wake setup failed: %d", err);
+            clearPxlLightSleepWake();
+            notifyLightSleepEnd.notifyObservers(ESP_SLEEP_WAKEUP_UNDEFINED);
+            return false;
+        }
+#endif
+        console->flush();
+        err = esp_pm_lock_release(pxlLightSleepLock);
+        if (err != ESP_OK) {
+            LOG_ERROR("PXL PM lock release failed: %d", err);
+            clearPxlLightSleepWake();
+            notifyLightSleepEnd.notifyObservers(ESP_SLEEP_WAKEUP_UNDEFINED);
+            return false;
+        }
+        pxlLightSleepAllowed = true;
+        return true;
+    }
+
+    esp_err_t err = esp_pm_lock_acquire(pxlLightSleepLock);
+    if (err != ESP_OK) {
+        LOG_ERROR("PXL PM lock reacquire failed: %d", err);
+        return false;
+    }
+    pxlLightSleepAllowed = false;
+    esp_sleep_wakeup_cause_t cause = esp_sleep_get_wakeup_cause();
+    clearPxlLightSleepWake();
+    notifyLightSleepEnd.notifyObservers(cause);
+    return true;
+}
+#endif
+
