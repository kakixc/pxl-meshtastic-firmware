 static void lsEnter()
 {
@@ -96,6 +101,51 @@ static void lsIdle()
 {
     // LOG_INFO("lsIdle begin ls_secs=%u", getPref_ls_secs());
 
+#ifdef PXL_HELTEC_V3_DYNAMIC_SLEEP
+    // An on-enter callback runs before arduino-fsm assigns stateLS; defer
+    // transitions and wake setup until this idle callback owns the state.
+    if (!pxlDynamicSession && pxlDynamicLightSleepAvailable()) {
+        if (!doPreflightSleep() || (RadioLibInterface::instance && RadioLibInterface::instance->isSending())) {
+            powerFSM.trigger(EVENT_WAKE_TIMER);
+            return;
+        }
+
+        pxlLightSleepStarted = millis();
+        statusLEDModule->setPowerLED(false);
+        if (!setPxlDynamicLightSleep(true)) {
+            statusLEDModule->setPowerLED(true);
+            powerFSM.trigger(EVENT_WAKE_TIMER);
+            return;
+        }
+        pxlDynamicSession = true;
+    }
+
+    if (pxlDynamicSession) {
+        if (!doPreflightSleep() || (RadioLibInterface::instance && RadioLibInterface::instance->isSending()) ||
+            (uint32_t)(millis() - pxlLightSleepStarted) >= (uint64_t)config.power.ls_secs * 1000ULL) {
+            powerFSM.trigger(EVENT_WAKE_TIMER);
+            return;
+        }
+
+        // RTC wake is level-triggered. Leave LS before restoring ordinary
+        // digital USER and DIO1 interrupts in lsExit().
+        switch (esp_sleep_get_wakeup_cause()) {
+        case ESP_SLEEP_WAKEUP_EXT1:
+            powerFSM.trigger(EVENT_PRESS);
+            return;
+        case ESP_SLEEP_WAKEUP_EXT0:
+            powerFSM.trigger(EVENT_WAKE_TIMER);
+            return;
+        case ESP_SLEEP_WAKEUP_UART:
+            powerFSM.trigger(EVENT_SERIAL_CONNECTED);
+            return;
+        default:
+            break;
+        }
+        return;
+    }
+#endif
+
 #ifdef ARCH_ESP32
 
     // Do we have more sleeping to do?
@@ -158,6 +208,19 @@ static void lsIdle()
 
 static void lsExit()
 {
+#ifdef PXL_HELTEC_V3_DYNAMIC_SLEEP
+    if (pxlDynamicSession) {
+        esp_sleep_wakeup_cause_t cause = esp_sleep_get_wakeup_cause();
+        if (!setPxlDynamicLightSleep(false))
+            LOG_ERROR("PXL PM lock could not be reacquired after wake");
+        pxlDynamicSession = false;
+        // The RTC wake may consume DIO1's rising edge. The radio chip keeps
+        // RX_DONE latched, so ask the existing RadioLib backup path now.
+        if (cause == ESP_SLEEP_WAKEUP_EXT0 && RadioLibInterface::instance)
+            RadioLibInterface::instance->pollMissedIrqs();
+        statusLEDModule->setPowerLED(true);
+    }
+#endif
     LOG_POWERFSM("State: lsExit");
 }
 
